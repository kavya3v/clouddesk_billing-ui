# UI routing defaults to n8n. Set python only for an explicitly configured Python backend.
CHAT_BACKEND=n8n
PYTHON_CHAT_URL=http://127.0.0.1:8000/chat

# Exact published n8n chat endpoint URL (including any path or query string).
N8N_CHAT_URL=https://your-instance.app.n8n.cloud/webhook/your-published-chat-path

# Optional. Set both values to enable HTTP Basic Auth; otherwise leave both blank.
N8N_BASIC_USER=
N8N_BASIC_PASSWORD=

# Python backend integrations (used by the complete /chat pipeline).
# Keep these server-side. Never put real keys in source control.
FIREWORKS_API_KEY=
# Fixed by the reference workflow; documentary value, not an override.
FIREWORKS_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
# Fixed by the reference workflow; documentary value, not an override.
FIREWORKS_ANSWER_MODEL=accounts/fireworks/models/deepseek-v4p1-flash
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
